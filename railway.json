{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "mergewise_backend/Dockerfile",
    "watchPatterns": ["mergewise_backend/**", "package.json", "package-lock.json", "railway.json"]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
