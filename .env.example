# Copy this file to devpulse-backend/.env and fill in real values.
# Never commit the real .env file.

# --- Database & cache ---
DATABASE_URL="postgresql://devpulse:devpulse@localhost:5432/devpulse"
REDIS_URL="redis://localhost:6379"

# --- GitHub OAuth App (NOT the GitHub App used for webhooks/installs — that comes in Slice 2) ---
# Create at: https://github.com/settings/developers -> "New OAuth App"
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (Slice 2 — repository connection, separate from the OAuth
# App above) ---
# Create at: https://github.com/settings/apps -> "New GitHub App"
# Homepage URL: http://localhost:5173
# Setup URL (redirect after install): http://localhost:3000/github/setup
#   - check "Redirect on update" too, so re-installing/adding repos also
#     comes back through our sync
# Webhook: leave "Active" UNCHECKED for now — Slice 3 turns this on.
# Repository permissions: Contents (Read-only), Metadata (Read-only,
#   mandatory), Pull requests (Read-only) — requesting Pull requests access
#   now avoids a re-approval prompt when Slice 3 adds PR sync.
# Where can this GitHub App be installed: "Only on this account" is fine
#   for local dev.
# After creating: note the App ID (top of the page) and the slug from the
# app's URL (github.com/settings/apps/<slug>), then generate a private key
# and download the .pem.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
# Paste the full .pem contents on one line with \n in place of real
# newlines, e.g.: "-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# --- GitHub App webhook (Slice 3 — event ingestion) ---
# On the same GitHub App: Webhook tab -> check "Active" -> Webhook URL
# http://localhost:3000/webhooks/github (use ngrok/Cloudflare Tunnel for a
# real GitHub delivery in local dev, since GitHub can't reach localhost
# directly) -> generate a secret and paste it below.
# Subscribe to: "Pull requests" (that's the only event Slice 3 acts on;
# subscribing to more is harmless but unnecessary right now).
GITHUB_WEBHOOK_SECRET=

# --- Embeddings (Slice 8 — engineering-memory retrieval) ---
# Any OpenAI-compatible /embeddings endpoint. With a real OpenAI key, the
# defaults below (text-embedding-3-small, api.openai.com) just work. To
# point at a different provider (Azure OpenAI, a local model server, etc.),
# override EMBEDDING_API_BASE_URL and EMBEDDING_MODEL to match it.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE_URL=https://api.openai.com/v1

# --- LLM (Slice 9 — RAG-assisted PR intelligence) ---
# Any OpenAI-compatible /chat/completions endpoint. Two model tiers on
# purpose: MEDIUM-risk PRs use the cheaper model, HIGH/CRITICAL use the
# stronger one. LOW-risk PRs never call this at all — see
# rag/model-selector.ts. Can be the same provider/key as the embeddings
# above, or a different one.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o

# --- Sessions ---
# Any long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Invitation emails (optional) ---
# With both set, invitations are emailed through Resend (https://resend.com);
# EMAIL_FROM must use a domain verified in Resend, e.g.
# "Mergewise <invites@mail.yourdomain.com>". Without them, admins get each
# invite link to copy and send themselves.
RESEND_API_KEY=
EMAIL_FROM=

# --- App URLs ---
API_BASE_URL="http://localhost:3000"
WEB_BASE_URL="http://localhost:5173"

NODE_ENV=development
PORT=3000
